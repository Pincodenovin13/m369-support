# === M369 Support — Application ===

# Database (PostgreSQL)
# Runtime role: m369_app (least-privilege, NO BYPASSRLS)
# Migration role: postgres (superuser, used only by migration service)
#
# DEVELOPMENT ONLY — change all passwords in production via secrets manager.
POSTGRES_PASSWORD=change-this-local-development-password
M369_APP_PASSWORD=change-this-local-runtime-password
DATABASE_URL=postgresql+psycopg://m369_app:change-this-local-runtime-password@localhost:5432/m369_support
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/m369_support_test

# Super Admin management role (BYPASSRLS, NOSUPERUSER)
M369_SA_RUNNER_PASSWORD=change-this-local-sa-runner-password
DATABASE_URL_SUPER_ADMIN=postgresql+psycopg://m369_sa_runner:change-this-local-sa-runner-password@localhost:5432/m369_support

# Super Admin authentication-only role (NO BYPASSRLS, least-privilege)
# Used ONLY by /super-admin/auth/login and /super-admin/auth/login/verify-mfa
M369_SA_AUTH_PASSWORD=change-this-local-sa-auth-password
DATABASE_URL_SUPER_ADMIN_AUTH=postgresql+psycopg://m369_sa_auth:change-this-local-sa-auth-password@localhost:5432/m369_support

# RLS HMAC key: use the identical secret for migration and API; generate with secrets.token_urlsafe(48).
M369_TENANT_CONTEXT_SECRET=dev-only-m369-tenant-context-secret-change-before-production-0001

# JWT secrets (DEVELOPMENT ONLY — generate real keys for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-change-this-to-64-char-random-string-in-production-please
JWT_SUPER_ADMIN_SECRET_KEY=dev-only-super-admin-secret-change-this-too-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=10080
JWT_REFRESH_TOKEN_DAYS=30

# Argon2id password hashing parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Fernet encryption key for secrets at rest (DEVELOPMENT ONLY)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dev-only-change-this-key-please-32-bytes-base64-url-safe

# CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate limiting
RATE_LIMIT_ENABLED=true

# Only exact immediate reverse-proxy IPs. Never trust arbitrary clients.
# Empty (default) = API receives connections directly — X-Forwarded-For is
# NEVER trusted. Set to the proxy's IP (e.g. "10.0.0.1" or "172.16.0.5")
# ONLY if the API is deployed behind a reverse proxy that overwrites
# X-Forwarded-For on every request.
TRUSTED_PROXY_IPS=

# Environment
ENVIRONMENT=development
DEBUG=true

# Redis (for rate limiting + future job queue)
REDIS_URL=redis://localhost:6379/0

# === Frontend (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=M369 Support

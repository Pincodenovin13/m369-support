# === M369 Support — Application ===

# Database (PostgreSQL)
# Runtime role: m369_app (least-privilege, NO BYPASSRLS)
# Migration role: postgres (superuser, used only for alembic upgrade)
DATABASE_URL=postgresql+psycopg://m369_app:m369_app_dev_password@localhost:5432/m369_support
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/m369_support_test

# JWT secrets (CHANGE THESE IN PRODUCTION)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-change-this-to-64-char-random-string-in-production-please
JWT_SUPER_ADMIN_SECRET_KEY=dev-only-super-admin-secret-change-this-too-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=10080
JWT_REFRESH_TOKEN_DAYS=30

# Argon2id password hashing parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Fernet encryption key for secrets at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dev-only-change-this-key-please-32-bytes-base64-url-safe

# CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate limiting
RATE_LIMIT_ENABLED=true

# Environment
ENVIRONMENT=development
DEBUG=true

# Redis (for rate limiting + future job queue)
REDIS_URL=redis://localhost:6379/0

# === Frontend (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=M369 Support

+"""Demo endpoint proving the multi-tenancy foundation works.
+
+This router exists so the foundation introduced in ``app/tenant.py`` is
+exercised end-to-end through an HTTP request, not just by unit tests. It is
+intentionally tiny: the goal is to wire ``get_current_agency_id`` and
+``assert_tenant_owned`` into a real request path and show that a user from
+agency A is denied agency B's row.
+
+It reads a client by id through the foundation primitives only — no inline
+``Client.agency_id == user.agency_id`` clause — so the test suite can prove
+the helper itself enforces isolation, not that any one router happens to.
+
+The router is mounted under ``/api/tenancy`` so it sits apart from the
+existing surface area and is easy to remove when the foundation is folded
+into the regular routers.
+"""
+
+from __future__ import annotations
+
+import uuid
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy.orm import Session
+
+from ..database import get_db
+from ..models import Client
+from ..schemas import ClientOut
+from ..tenant import assert_tenant_owned, get_current_agency_id
+
+
+router = APIRouter(prefix="/tenancy", tags=["Multi-tenancy"])
+
+
+@router.get("/clients/{client_id}", response_model=ClientOut)
+def get_client_through_foundation(
+    client_id: uuid.UUID,
+    db: Session = Depends(get_db),
+    agency_id: uuid.UUID = Depends(get_current_agency_id),
+):
+    """Resolve a client through the tenant foundation primitives.
+
+    Flow:
+
+    1. ``get_current_agency_id`` resolves the agency from the cookie, not
+       from any request body or path parameter a client can influence.
+    2. The client row is fetched by id alone — a deliberate demonstration
+       that the ownership check is what blocks cross-tenant reads, not the
+       ``where`` clause of the ``select``. (In a real router the ``select``
+       would still filter by agency_id as defense-in-depth; this endpoint
+       does not, so the test can prove the helper is the load-bearing
+       layer.)
+    3. ``assert_tenant_owned`` rejects rows whose ``agency_id`` does not
+       match the resolved one, raising 404 — the same convention every
+       existing ``_client`` / ``_conversation`` helper uses.
+    """
+
+    client = db.get(Client, client_id)
+    if client is None:
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Client not found")
+    assert_tenant_owned(client, agency_id)
+    return client

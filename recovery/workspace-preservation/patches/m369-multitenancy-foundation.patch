+"""Test configuration additions for the multi-tenancy foundation.
+
+Registers the ``integration`` marker so ``pytest -m "not integration"``
+keeps the suite green on a host with no PostgreSQL. The marker is the only
+addition; the existing ``conftest.py`` continues to drive fixtures.
+"""
+
+import pytest
+
+
+def pytest_configure(config):
+    config.addinivalue_line(
+        "markers",
+        "integration: tests that need a live PostgreSQL test database",
+    )
diff --git a/apps/api/tests/test_tenant_foundation.py b/apps/api/tests/test_tenant_foundation.py
new file mode 100644
index 0000000..a22cf7e
--- /dev/null
+++ b/apps/api/tests/test_tenant_foundation.py
@@ -0,0 +1,256 @@
+"""Multi-tenancy foundation tests.
+
+Three layers of evidence:
+
+1. **Pure unit tests** of ``assert_tenant_owned`` — no database, no FastAPI.
+   These always run; they prove the helper's behaviour (404 on mismatch,
+   404 on None agency, pass on match) at the language level.
+
+2. **JWT strictness tests** of ``decode_access_token`` after the type-check
+   fix — no database, no FastAPI. These prove a portal token is no longer
+   accepted as an agency token.
+
+3. **Runtime isolation tests** that go through the demo router with two
+   real agencies and a real (test) Postgres. These prove end-to-end that
+   agency A cannot read agency B's client through the foundation
+   primitives. They are marked ``@pytest.mark.integration`` and require a
+   running PostgreSQL test database; when none is available they are
+   skipped, not silently passed.
+"""
+
+from __future__ import annotations
+
+import uuid
+
+import pytest
+
+from app.security import create_access_token, create_portal_token, decode_access_token
+from app.tenant import assert_tenant_owned
+
+
+# ---------------------------------------------------------------------------
+# 1. Pure unit tests of the ownership helper — no DB, no FastAPI.
+# ---------------------------------------------------------------------------
+
+
+class _Stub:
+    """Tiny stand-in for a SQLAlchemy row.
+
+    ``assert_tenant_owned`` only reads one attribute, so a plain object is a
+    faithful and dependency-free substitute for a model instance.
+    """
+
+    def __init__(self, agency_id: uuid.UUID | None) -> None:
+        self.agency_id = agency_id
+
+
+def test_assert_tenant_owned_passes_when_agency_matches():
+    agency = uuid.uuid4()
+    record = _Stub(agency)
+    # No exception means pass.
+    assert_tenant_owned(record, agency)
+
+
+def test_assert_tenant_owned_rejects_other_agency_with_404():
+    owner = uuid.uuid4()
+    intruder = uuid.uuid4()
+    record = _Stub(owner)
+    from fastapi import HTTPException
+
+    with pytest.raises(HTTPException) as exc:
+        assert_tenant_owned(record, intruder)
+    assert exc.value.status_code == 404
+    # The detail must not leak whose row it is.
+    assert "agency" not in exc.value.detail.lower()
+
+
+def test_assert_tenant_owned_fails_closed_on_missing_agency_id():
+    """A row without an ``agency_id`` is a data-integrity problem; the
+    helper rejects it rather than silently letting the request through."""
+    agency = uuid.uuid4()
+    record = _Stub(None)
+    from fastapi import HTTPException
+
+    with pytest.raises(HTTPException) as exc:
+        assert_tenant_owned(record, agency)
+    assert exc.value.status_code == 404
+
+
+def test_assert_tenant_owned_supports_custom_attr():
+    """Some tables scope by ``client_id`` first; the helper must still work
+    when the column is reached through a different attribute name."""
+    client_id = uuid.uuid4()
+    record = _Stub(None)  # ``agency_id`` is None on purpose
+    record.client_id = client_id
+    assert_tenant_owned(record, client_id, agency_attr="client_id")
+
+
+# ---------------------------------------------------------------------------
+# 2. JWT type-strictness tests of decode_access_token.
+# ---------------------------------------------------------------------------
+
+
+def test_decode_access_token_rejects_portal_token():
+    """The Class B weakness documented in Phase 0.C: a portal token must
+    not decode as an agency token even though both are signed with the same
+    ``secret_key``."""
+    client_id = str(uuid.uuid4())
+    portal_token = create_portal_token(client_id, "portal-slug", portal_user_id=str(uuid.uuid4()))
+    # Before the fix this returned the ``client_id``; after the fix it must
+    # return None because the payload carries ``type=portal``.
+    assert decode_access_token(portal_token) is None
+
+
+def test_decode_access_token_accepts_agency_token_without_type_claim():
+    """Regression guard: the fix must not break the legitimate agency
+    token, which carries no ``type`` claim at all."""
+    user_id = str(uuid.uuid4())
+    agency_token = create_access_token(user_id)
+    assert decode_access_token(agency_token) == user_id
+
+
+def test_decode_access_token_rejects_garbage():
+    assert decode_access_token("not.a.jwt") is None
+    assert decode_access_token("") is None
+
+
+# ---------------------------------------------------------------------------
+# 3. Runtime cross-tenant isolation — needs a real PostgreSQL test DB.
+# ---------------------------------------------------------------------------
+
+integration = pytest.mark.integration
+
+
+def _postgres_available() -> bool:
+    """Detect a live PostgreSQL test database the way the suite already
+    configures it: ``TEST_DATABASE_URL`` or the default local DSN."""
+    import os
+
+    from sqlalchemy import create_engine
+    from sqlalchemy.exc import OperationalError
+
+    url = os.environ.get(
+        "TEST_DATABASE_URL",
+        "postgresql+psycopg://openlivery:openlivery@localhost:5432/openlivery_test",
+    )
+    try:
+        engine = create_engine(url, pool_pre_ping=True)
+        with engine.connect() as conn:
+            conn.exec_driver_sql("SELECT 1")
+        return True
+    except OperationalError:
+        return False
+    except Exception:  # noqa: BLE001 — any failure means unavailable
+        return False
+
+
+_HAVE_PG = _postgres_available()
+
+
+@integration
+@pytest.mark.skipif(not _HAVE_PG, reason="PostgreSQL test database unavailable")
+def test_agency_a_cannot_read_agency_b_client(authenticated_client):
+    """End-to-end: agency A registers, creates a client; agency B registers
+    separately, and the demo router must deny B access to A's client.
+
+    Uses the existing ``authenticated_client`` fixture which registers one
+    agency; we register the second one out-of-band by swapping the cookie.
+    """
+    import uuid as _uuid
+
+    from fastapi.testclient import TestClient
+
+    from app.database import get_db
+    from app.models import Agency, Client, User, new_uuid
+    from app.security import hash_password
+
+    # --- Agency A: register through the API so the cookie is set. ---------
+    agency_a_client_id_resp = authenticated_client.post(
+        "/api/clients", json={"name": "Alpha Shop"}
+    )
+    assert agency_a_client_id_resp.status_code == 201
+    agency_a_client = agency_a_client_id_resp.json()
+
+    # --- Agency B: register directly against the DB, since the API closes
+    #     registration after the first agency is created (single-agency
+    #     lock — known issue, separate phase). We then sign in as B. -------
+    a_cookie = authenticated_client.cookies.get("access_token")
+    assert a_cookie, "agency A cookie must be set after register"
+
+    # Direct DB insert for agency B (the registration endpoint would refuse).
+    with app_database_session() as db:
+        agency_b = Agency(name="Beta Shop", slug="beta-shop-" + _uuid.uuid4().hex[:8])
+        user_b = User(
+            agency=agency_b,
+            name="Beta Admin",
+            email="beta@example.com",
+            password_hash=hash_password("beta-password-secure"),
+        )
+        db.add(user_b)
+        db.commit()
+        db.refresh(user_b)
+        user_b_id = str(user_b.id)
+
+    # Sign in as B and steal its cookie.
+    # We can't call /api/auth/register (closed) and /api/auth/login is the
+    # path that already works. Issue a login through the same TestClient
+    # instance, but TestClient shares cookie jar across requests, so we open
+    # a fresh client instead.
+    from app.main import app
+
+    fresh = TestClient(app)
+    login_resp = fresh.post("/api/auth/login", json={"email": "beta@example.com", "password": "beta-password-secure"})
+    assert login_resp.status_code == 200, login_resp.text
+
+    # --- Try to read A's client through the demo router as B. -------------
+    target = f"/api/tenancy/clients/{agency_a_client['id']}"
+    denied = fresh.get(target)
+    assert denied.status_code == 404, (
+        f"cross-tenant leak: agency B accessed agency A's client, got {denied.status_code} {denied.text}"
+    )
+
+    # --- Sanity: as A, the same client is reachable. ----------------------
+    own = authenticated_client.get(target)
+    assert own.status_code == 200
+    assert own.json()["id"] == agency_a_client["id"]
+
+
+@integration
+@pytest.mark.skipif(not _HAVE_PG, reason="PostgreSQL test database unavailable")
+def test_missing_tenant_context_is_rejected(authenticated_client):
+    """An unauthenticated request to the demo router must 401, not 200 or
+    leak any tenant data."""
+    import uuid as _uuid
+
+    from fastapi.testclient import TestClient
+
+    from app.main import app
+
+    unauth = TestClient(app)
+    target = f"/api/tenancy/clients/{_uuid.uuid4()}"
+    denied = unauth.get(target)
+    assert denied.status_code == 401, denied.text
+
+
+# ---------------------------------------------------------------------------
+# Helper: open a DB session outside the request flow.
+# ---------------------------------------------------------------------------
+
+
+def app_database_session():
+    """A context manager that yields a SQLAlchemy session against the same
+    engine the app uses. Used only by the integration tests above to seed a
+    second agency while registration is closed."""
+    from contextlib import contextmanager
+
+    from app.database import new_session
+
+    @contextmanager
+    def _cm():
+        db = new_session()
+        try:
+            yield db
+        finally:
+            db.close()
+
+    return _cm()

diff --git a/apps/api/app/tenant.py b/apps/api/app/tenant.py
new file mode 100644
index 0000000..2cd3c5f
--- /dev/null
+++ b/apps/api/app/tenant.py
@@ -0,0 +1,112 @@
+"""Multi-tenancy foundation primitives.
+
+This module is the single place the agency the current request belongs to is
+resolved, and the single place ownership of a tenant-scoped row is checked.
+
+Why a dedicated module
+----------------------
+Before this module every router that needed the current agency reached for
+``user.agency_id`` directly and re-implemented the same check inline. That is
+workable while there is one shape of authenticated principal, but it is a
+fragile foundation for the multi-tenant SaaS the project is becoming:
+
+* a future Super Admin principal carries no ``agency_id`` at all, and the
+  decision "the super admin is not bound to a tenant" must live in exactly one
+  place, not be re-decided in 24 routers;
+* a developer adding a new endpoint can forget the ``agency_id == user.agency_id``
+  clause and silently leak another agency's data — the helper here is what
+  they reach for instead of writing the clause from scratch;
+* background jobs resolve the agency from a row, not from a cookie, and need
+  the same ownership check without re-implementing it.
+
+What this module does NOT do
+----------------------------
+It does not rewrite existing routers. They keep their inline
+``Client.agency_id == user.agency_id`` clauses — those continue to work and
+this module is the documented home for the next ones. Refactoring every
+endpoint to call into here is a separate, larger change that must be made one
+router at a time.
+
+It does not touch the database. Every column it needs (``users.agency_id``)
+already exists from migration ``0001_initial``.
+
+It does not introduce a JWT ``type`` claim of its own. The agency JWT keeps the
+shape ``security.create_access_token`` already produces; only ``decode_access_token``
+becomes strict about rejecting tokens that carry ``type=portal`` (which it
+already should have).
+"""
+
+from __future__ import annotations
+
+import uuid
+from typing import Any, Protocol
+
+from fastapi import Depends, HTTPException, status
+from sqlalchemy.orm import Session
+
+from .database import get_db
+from .deps import get_current_user
+from .models import User
+
+
+class TenantOwned(Protocol):
+    """Anything that carries an ``agency_id`` column.
+
+    The concrete models (``Agency``, ``User``, ``Client``, ``Agent``,
+    ``Conversation``, ``WhatsAppChannel`` …) all expose ``agency_id`` as a
+    non-null UUID column. ``Protocol`` keeps the helper open to those models
+    without coupling it to a fixed list, so a new tenant-owned table needs no
+    change here.
+    """
+
+    agency_id: uuid.UUID
+
+
+def get_current_agency_id(user: User = Depends(get_current_user)) -> uuid.UUID:
+    """Resolve the agency the current request belongs to.
+
+    A single dependency every tenant-scoped endpoint can depend on instead of
+    reading ``user.agency_id`` inline. Today the source is the authenticated
+    ``User`` row; tomorrow the same dependency can branch on a Super Admin
+    principal without every router changing.
+
+    Fails closed (401) when the authenticated user has no agency — a User row
+    with a NULL ``agency_id`` cannot exist given the column is NOT NULL, but
+    the check keeps the dependency honest if that constraint is ever relaxed
+    for an off-platform account (super admins, internal service accounts).
+    """
+
+    if user.agency_id is None:  # pragma: no cover - column is NOT NULL today
+        raise HTTPException(
+            status_code=status.HTTP_401_UNAUTHORIZED,
+            detail="The account is not bound to an agency",
+        )
+    return user.agency_id
+
+
+def assert_tenant_owned(
+    record: Any,
+    agency_id: uuid.UUID,
+    *,
+    agency_attr: str = "agency_id",
+) -> None:
+    """Fail-closed ownership check for a tenant-scoped row.
+
+    Use after fetching a row by id (or after building it in memory) to confirm
+    it belongs to ``agency_id`` before returning, mutating or deleting it.
+
+    Fail-closed means a row whose ``agency_attr`` is None is rejected: an
+    unscoped row in a multi-tenant table is a data integrity problem, and
+    returning it would be a leak even if the caller happens to be the same
+    agency the row should have belonged to.
+
+    The helper raises ``404 Not Found`` rather than ``403 Forbidden``: the
+    row may well exist, but a tenant who does not own it must learn nothing
+    about it, not even that it exists under another agency. This matches the
+    convention every existing ``_client``/``_conversation`` helper already
+    follows.
+    """
+
+    record_agency = getattr(record, agency_attr, None)
+    if record_agency is None or record_agency != agency_id:
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Resource not found")
